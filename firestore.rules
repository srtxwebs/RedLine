rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin username account (created in Firebase → Authentication → Users)
    function adminLogins() { return ['admin1100@redline.admin']; }
    // Optional Google admins (lowercase) — same list as adminEmails in js/config.js
    function googleAdmins() { return []; }

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email != null && (
        (request.auth.token.firebase.sign_in_provider == 'password'
          && request.auth.token.email.lower() in adminLogins())
        || (request.auth.token.email_verified == true
          && request.auth.token.email.lower() in googleAdmins())
      );
    }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    function validProfile(d, uid) {
      return d.uid == uid
        && d.email == request.auth.token.email
        && d.displayName is string && d.displayName.size() <= 80
        && d.photo is string && d.photo.size() < 400000
        && (!('bio' in d) || (d.bio is string && d.bio.size() <= 600))
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 40))
        && (!('company' in d) || (d.company is string && d.company.size() <= 120));
    }

    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create, update: if isMe(uid) && validProfile(request.resource.data, uid);
      allow delete: if isAdmin();
    }

    match /listings/{id} {
      allow read: if resource.data.status in ['available', 'sold'] || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.status in ['available', 'sold', 'hidden']
        && request.resource.data.price is number;
      allow delete: if isAdmin();
    }
    match /listingImages/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /slots/{slotId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'bookingId', 'date', 'createdAt'])
        && slotId.matches('^' + request.resource.data.date + '_[0-9]{4}$');
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /bookings/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && existsAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId))
        && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.bookingId == id
        && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.uid == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
